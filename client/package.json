{
  "name": "proton-calendar-client",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/to-bi-s/neutron-calendar-bridge.git",
    "directory": "client"
  },
  "version": "0.1.0",
  "description": "Extracted standalone runtime for the working Proton Calendar TypeScript API",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/proton-cli.mjs",
    "./daemon": "./dist/proton-daemon.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "proton-calendar-cli": "./dist/proton-cli.mjs",
    "proton-calendar-daemon": "./dist/proton-daemon.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@noble/ed25519": "1.7.5",
    "@protontech/crypto": "2.1.3",
    "@protontech/mimemessage": "1.1.4",
    "@protontech/timezone-support": "2.1.0",
    "core-js": "3.50.0",
    "date-fns": "2.30.0",
    "dompurify": "3.2.6",
    "esbuild": "0.25.10",
    "file-saver": "2.0.5",
    "ical.js": "1.5.0",
    "lodash": "4.17.21",
    "node-fetch": "3.3.2",
    "openpgp": "npm:@protontech/openpgp@6.3.1",
    "pkijs": "3.2.5",
    "tinycolor2": "1.6.0",
    "tsx": "4.20.4",
    "ttag": "1.8.12",
    "typescript": "5.9.2",
    "ua-parser-js": "1.0.41"
  },
  "scripts": {
    "audit:runtime-deps": "node scripts/audit-runtime-deps.mjs",
    "build": "node scripts/build-runtime.mjs",
    "export:repo": "node scripts/export-standalone-repo.mjs",
    "prepare": "npm run build",
    "prune:vendor-build": "node scripts/prune-vendor-by-build.mjs",
    "vendor:proton": "node scripts/vendor-proton-workspace.mjs",
    "cli": "node dist/proton-cli.mjs",
    "cli:src": "tsx src/proton-cli.ts",
    "daemon": "node dist/proton-daemon.mjs",
    "daemon:src": "tsx src/proton-daemon.ts",
    "smoke": "npm run smoke:dist",
    "smoke:dist": "npm run build && node dist/smoke-test.mjs",
    "smoke:src": "tsx scripts/smoke-test.ts",
    "test:series": "npm run build && node dist/series-roundtrip-test.mjs",
    "test:participants": "npm run build && node dist/participants-test.mjs",
    "test:invitations": "npm run build && node dist/invitations-test.mjs",
    "test:organizer": "npm run build && node dist/organizer-test.mjs",
    "test:organizer-series": "npm run build && node dist/organizer-series-test.mjs",
    "test:emailed-answers": "npm run build && node dist/emailed-answers-test.mjs",
    "test:calendar-emails": "npm run build && node dist/calendar-emails-test.mjs",
    "test:session": "npm run build && node dist/session-test.mjs",
    "test:state-files": "npm run build && node dist/state-files-test.mjs",
    "test:change-feed": "npm run build && node dist/change-feed-test.mjs",
    "test:sign-in": "npm run build && node dist/sign-in-test.mjs",
    "test:invitation-language": "npm run build && node dist/invitation-language-test.mjs",
    "locales:extract": "node scripts/extract-invitation-locales.mjs",
    "check": "npm run test:offline",
    "test:live": "npm run build && node scripts/live-test.mjs",
    "test:offline": "npm run build && node dist/series-roundtrip-test.mjs && node dist/participants-test.mjs && node dist/invitations-test.mjs && node dist/organizer-test.mjs && node dist/organizer-series-test.mjs && node dist/emailed-answers-test.mjs && node dist/calendar-emails-test.mjs && node dist/session-test.mjs && node dist/state-files-test.mjs && node dist/change-feed-test.mjs && node dist/sign-in-test.mjs && node dist/invitation-language-test.mjs && node dist/reminders-test.mjs && node dist/busy-test.mjs && node dist/video-links-test.mjs && node dist/zones-test.mjs && node dist/calendar-colours-test.mjs && node dist/app-identity-test.mjs",
    "refresh:proton": "node scripts/refresh-proton.mjs",
    "test:reminders": "npm run build && node dist/reminders-test.mjs",
    "test:busy": "npm run build && node dist/busy-test.mjs",
    "test:video": "npm run build && node dist/video-links-test.mjs",
    "test:zones": "npm run build && node dist/zones-test.mjs",
    "test:calendar-colours": "npm run build && node dist/calendar-colours-test.mjs",
    "test:app-identity": "npm run build && node dist/app-identity-test.mjs"
  }
}
