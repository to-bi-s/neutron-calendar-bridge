<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Stage 16: what Electron's JavaScript engine needs under the hardened runtime. Library
         validation stays on (electron-builder's default turns it off): every native module in the
         app (SQLCipher, the menu spinner) is signed with the same Developer ID. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
